{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/check-node-version.mjs && node packages/mochi-assets/copy-assets.mjs public && node scripts/run-framework.mjs dev",
    "build": "node scripts/check-node-version.mjs && node packages/mochi-assets/copy-assets.mjs public && node scripts/run-framework.mjs build",
    "dev:pages": "node scripts/check-node-version.mjs && node packages/mochi-assets/copy-assets.mjs public && vite --config vite.pages.config.ts",
    "build:pages": "node scripts/check-node-version.mjs && node packages/mochi-assets/copy-assets.mjs public && vite build --config vite.pages.config.ts",
    "preview:pages": "node scripts/check-node-version.mjs && vite preview --config vite.pages.config.ts",
    "build:cloudflare": "node scripts/check-node-version.mjs && node packages/mochi-assets/copy-assets.mjs public && vite build --config vite.pages.config.ts --mode cloudflare",
    "preview:cloudflare": "node scripts/check-node-version.mjs && vite preview --config vite.pages.config.ts --mode cloudflare",
    "start": "node scripts/check-node-version.mjs && node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "assets:sync": "node packages/mochi-assets/copy-assets.mjs public",
    "assets:check": "node packages/mochi-assets/copy-assets.mjs public --check",
    "check:node": "node scripts/check-node-version.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20260730.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.0.16",
    "wrangler": "4.116.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "undici@>=7.0.0 <8.0.0": "7.30.1",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "browserslist@>=4.0.0 <5.0.0": "4.28.7",
    "baseline-browser-mapping@>=2.0.0 <3.0.0": "2.11.0",
    "fflate@>=0.7.0 <0.8.0": "0.7.5",
    "fast-uri@>=3.0.0 <4.0.0": "3.1.8",
    "esbuild@0.28.0": "0.28.1"
  },
  "packageManager": "pnpm@11.25.0"
}
